# ==============================================================================
# Root .gitignore for SkillVistaar (Full-Stack Monorepo)
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~

# Environment & Secrets (Never commit credentials)
.env
.env.*
*.env
*.env.local
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/

# Backend (Python / FastAPI)
**/__pycache__/
**/*.py[cod]
backend/venv/
backend/.venv/
backend/env/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/*.sqlite
backend/*.db

# Uploaded files (ephemeral on cloud platforms)
storage/
backend/storage/

# Temporary & Build Directories
build/
dist/
node_modules/
tmp/
scratch/
.venv/
