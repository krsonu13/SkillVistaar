# ============================================================
# SkillVistaar Frontend Environment Configuration
# ============================================================
#
# Copy this file to .env and configure for your environment.
#
# LOCAL DEVELOPMENT:
#   When using Vite's dev server with proxy (vite.config.ts proxies /api → localhost:8000),
#   you can leave VITE_API_BASE_URL unset or use the default below.
#
# PRODUCTION (Vercel):
#   Set VITE_API_BASE_URL to your deployed backend URL.
#   Example: VITE_API_BASE_URL=https://skillvistaar-api.onrender.com/api/v1
#
# ============================================================

# Backend API base URL (include /api/v1 suffix)
# Local dev (optional — Vite proxy handles it when unset):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Production (REQUIRED):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
