# ============================================================
# SkillVistaar Backend Environment Configuration (Local Host)
# ============================================================

# Application
PROJECT_NAME=SkillVistaar
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server (Local Host)
HOST=127.0.0.1
PORT=8000

# ============================================================
# PostgreSQL (Local)
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillvistaar
POSTGRES_USER=skillvistaar
POSTGRES_PASSWORD=skillvistaar_dev_password

DATABASE_URL=postgresql+asyncpg://skillvistaar:skillvistaar_dev_password@localhost:5432/skillvistaar

# ============================================================
# JWT / Authentication
# ============================================================

JWT_SECRET_KEY=SkillVistaar_local_dev_access_secret_key_12345
JWT_REFRESH_SECRET_KEY=SkillVistaar_local_dev_refresh_secret_key_12345

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_ALGORITHM=HS256

# ============================================================
# CORS (Local Host)
# ============================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Redis / Valkey (Local)
# ============================================================

REDIS_URL=redis://localhost:6379/0

# ============================================================
# File Storage (Local Filesystem)
# ============================================================

STORAGE_ROOT=./storage
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# Email (Gmail / SMTP Provider Configuration)
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillVistaar Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_EXPIRY_MINUTES=10

# ============================================================
# SMS / OTP (Local Sandbox Simulator)
# ============================================================
# In local sandbox mode, phone OTP is displayed on screen and logged to stdout:
SMS_PROVIDER=sandbox
ALLOW_DEMO_SMS=true

# ============================================================
# Blockchain (Disabled locally by default)
# ============================================================

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK_ID=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# ============================================================
# AI
# ============================================================

AI_ENABLED=true
AI_PROVIDER=
AI_API_KEY=

# ============================================================
# Security
# ============================================================

PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO