# ============================================================
# SkillVistaar Backend Environment Configuration
# ============================================================
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# ============================================================

# ============================================================
# Application
# ============================================================

PROJECT_NAME=SkillVistaar
# Set to "production" for deployed environments.
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ============================================================
# Server
# ============================================================
# In production (Render), PORT is set automatically by the platform.

HOST=127.0.0.1
PORT=8000

# ============================================================
# PostgreSQL
# ============================================================
# Option 1: Full connection URL (preferred for production).
#   Render provides this as DATABASE_URL.
#   Supports: postgres://, postgresql://, postgresql+asyncpg://
# Option 2: Individual connection parameters (for local development).

DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillvistaar
POSTGRES_USER=skillvistaar
POSTGRES_PASSWORD=<CHANGE_ME>

# ============================================================
# JWT / Authentication (REQUIRED — must be unique per environment)
# ============================================================
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET_KEY=<CHANGE_ME_GENERATE_A_STRONG_SECRET>
JWT_REFRESH_SECRET_KEY=<CHANGE_ME_GENERATE_A_STRONG_SECRET>

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ============================================================
# CORS
# ============================================================
# Comma-separated list or JSON array of allowed frontend origins.
# Local development:
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production:
#   CORS_ORIGINS=https://your-frontend-domain.vercel.app

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Redis / Valkey (Optional)
# ============================================================

REDIS_URL=redis://localhost:6379/0

# ============================================================
# File Storage
# ============================================================
# "local" — filesystem storage (development only; ephemeral on Render)
# "s3"    — S3-compatible object storage (Cloudflare R2, AWS S3, Supabase)

STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=10

# S3 / Cloudflare R2 / Supabase Storage (required when STORAGE_BACKEND=s3)
# STORAGE_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET_NAME=skillvistaar
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=auto
# STORAGE_S3_PUBLIC_URL_PREFIX=

# ============================================================
# Email (SMTP)
# ============================================================
# Gmail: Use a 16-character Google App Password (not your login password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillVistaar Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_EXPIRY_MINUTES=10

# ============================================================
# SMS / OTP
# ============================================================
# "sandbox" — simulated SMS delivery (free, for development)
# "twilio"  — Twilio SMS provider (production)
# "msg91"   — MSG91 SMS provider (India)

SMS_PROVIDER=sandbox
ALLOW_DEMO_SMS=true

# Twilio (required when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# MSG91 (required when SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Legacy SMS
# SMS_API_KEY=
# SMS_SENDER_ID=

# ============================================================
# Blockchain (Optional)
# ============================================================

BLOCKCHAIN_ENABLED=false
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_NETWORK_ID=
# BLOCKCHAIN_PRIVATE_KEY=
# BLOCKCHAIN_CONTRACT_ADDRESS=

# ============================================================
# AI (Optional)
# ============================================================

AI_ENABLED=true
# AI_PROVIDER=
# AI_API_KEY=

# ============================================================
# Security
# ============================================================

PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ============================================================
# MFA
# ============================================================

MFA_ISSUER=SkillVistaar

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO