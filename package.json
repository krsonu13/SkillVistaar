{
  "name": "skillvistaar",
  "version": "1.0.0",
  "private": true,
  "description": "SkillVistaar - National Skill Verification & Stakeholder Management Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "cd backend && venv/bin/python3 -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "backend:test": "cd backend && venv/bin/python3 -m pytest"
  }
}
